# Public site URL (no trailing slash). Used for canonical, sitemap, RSS, OG.
SITE_URL=https://example.com

# Google Analytics 4 measurement ID (loaded only after consent). Leave empty to disable.
PUBLIC_GA4_ID=

# Google AdSense publisher ID, e.g. ca-pub-1234567890123456. Leave empty to render placeholders only.
PUBLIC_ADSENSE_CLIENT=

# IndexNow key (32 hex chars recommended). Leave empty to disable pinging.
INDEXNOW_KEY=

# Set to "true" to allow the post-build IndexNow ping (CI/production only).
INDEXNOW_ENABLED=false
