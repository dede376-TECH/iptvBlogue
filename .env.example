# Required. No trailing slash.
# Until a domain is bought, set the *.vercel.app URL shown in the Vercel project
# (Settings → Domains). Any URL whose host ends in .vercel.app is noindexed.
# The value below is the current Vercel production URL. Change it when the project gets a domain.
# Never use the CI-only fallback (*.invalid) here: builds refuse it outside GitHub Actions.
SITE_URL=https://screenwise-one.vercel.app

# "true" only when the host's plan allows commercial use.
# Vercel Hobby: leave false. Ads and affiliate links must stay off while this is not true.
PUBLIC_HOSTING_COMMERCIAL=false

# Google Analytics 4 measurement ID. Empty: no gtag snippet and no analytics consent category.
PUBLIC_GA4_ID=

# Google AdSense publisher ID, e.g. ca-pub-1234567890123456.
# Empty, or ignored while PUBLIC_HOSTING_COMMERCIAL is not true. ads.txt is omitted in that case.
PUBLIC_ADSENSE_CLIENT=

# IndexNow key. Empty: no ping, and /indexnow-key.txt is not published.
INDEXNOW_KEY=

# "true" to allow the post-build IndexNow ping. Kept false on the temporary Vercel host.
INDEXNOW_ENABLED=false
