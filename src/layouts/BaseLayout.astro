---
/**
 * HTML shell shared by every page: head (SEO, JSON-LD, fonts), header, footer, consent banner.
 * Navigation labels come from the content collections – nothing is hardcoded here.
 */
import '@/styles/global.css';
import SEO from '@/components/SEO.astro';
import JsonLd from '@/components/JsonLd.astro';
import { getVisibleClusters } from '@/lib/content';
import { getCollection } from 'astro:content';
import { clusterUrl, pageUrl, FOOTER_PAGE_ORDER } from '@/lib/links';
import { graph, organizationSchema, websiteSchema, type SeoMeta } from '@/lib/seo';
import { ADS, ANALYTICS, SITE } from '@/lib/site';

interface Props {
  meta: SeoMeta;
  /** Extra JSON-LD nodes merged into the page @graph. */
  schema?: Record<string, unknown>[];
  /** `minimal` hides navigation for distraction-free paid-test pages. */
  template?: 'default' | 'minimal';
  bodyClass?: string;
}

const { meta, schema = [], template = 'default', bodyClass = '' } = Astro.props;

const clusters = await getVisibleClusters();
const pages = await getCollection('pages');
const footerPages = FOOTER_PAGE_ORDER.map((slug) => pages.find((p) => p.id === slug)).filter(
  (p): p is NonNullable<typeof p> => Boolean(p),
);

const jsonLd = graph(organizationSchema(), websiteSchema(), ...schema);
const clientConfig = {
  ga4Id: ANALYTICS.ga4Id,
  adsenseClient: ADS.adsenseClient,
  npaWithoutConsent: ADS.npaWithoutConsent,
};
const year = new Date().getFullYear();
// __SCREENWISE_CONSENT__ is the literal false/true from the build, so the import below
// is dropped from the bundle while analytics and advertising are both off.
let ConsentRuntime: (typeof import('@/components/ConsentRuntime.astro'))['default'] | null = null;
if (__SCREENWISE_CONSENT__) {
  ConsentRuntime = (await import('@/components/ConsentRuntime.astro')).default;
}
---

<!doctype html>
<html lang={meta.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO meta={meta} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {!SITE.temporaryHost && <link rel="sitemap" href="/sitemap-index.xml" />}
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} RSS`} href="/rss.xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b1220" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <JsonLd data={jsonLd} />
  </head>
  <body class:list={['flex min-h-screen flex-col', `template-${template}`, bodyClass]}>
    <a href="#main" class="skip-link">
      Skip to content
    </a>

    <header class="site-header">
      <div class="container header-bar">
        <a href="/" class="brand" data-area="header">
          <img src="/logo.svg" alt="" width="28" height="28" />
          <span>{SITE.name}</span>
        </a>
        <nav aria-label="Primary" class="site-nav" data-area="nav">
          {clusters.map((c) => (
            <a href={clusterUrl(c.id)}>{c.data.navLabel}</a>
          ))}
        </nav>
        <div class="header-tools">
          <a href="/search/" class="icon-button" aria-label="Search">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.75"></circle>
              <path
                d="M16 16.5 20 20.5"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
              ></path>
            </svg>
          </a>
          <details class="site-menu">
            <summary aria-label="Menu">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M4 7h16M4 12h16M4 17h16"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                ></path>
              </svg>
            </summary>
            <nav class="site-menu-panel" aria-label="Topics">
              {clusters.map((c) => (
                <a href={clusterUrl(c.id)}>{c.data.navLabel}</a>
              ))}
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid" data-area="footer">
        <div>
          <p class="footer-title">{SITE.name}</p>
          <p class="footer-note">{SITE.tagline}</p>
          <p class="footer-note">
            Informational only. We do not sell subscriptions or link to playlists or unlicensed
            services.
          </p>
        </div>
        <nav aria-label="Topics" class="site-footer-nav">
          <p class="footer-title">Topics</p>
          <ul class="footer-list">
            {clusters.map((c) => (
              <li>
                <a href={clusterUrl(c.id)}>{c.data.navLabel}</a>
              </li>
            ))}
          </ul>
        </nav>
        <nav aria-label="Site">
          <p class="footer-title">Site</p>
          <ul class="footer-list">
            {footerPages.map((p) => (
              <li>
                <a href={pageUrl(p.id)}>{p.data.navLabel ?? p.data.h1}</a>
              </li>
            ))}
            <li>
              <a href={`${pageUrl('cookies')}#preferences`}>
                Do Not Sell or Share My Personal Information
              </a>
            </li>
            <li>
              <a href="/rss.xml">RSS feed</a>
            </li>
          </ul>
        </nav>
      </div>
      <div class="footer-legal">
        <p class="container">
          © {SITE.foundedYear}
          {year > SITE.foundedYear ? `–${year}` : ''} {SITE.name}. All trademarks belong to their
          respective owners.
        </p>
      </div>
    </footer>

    {ConsentRuntime && <ConsentRuntime clientConfig={clientConfig} />}
  </body>
</html>
