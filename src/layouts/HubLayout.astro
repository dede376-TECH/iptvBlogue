---
/**
 * Cluster hub (pillar) page: H1, intro, featured pillar article, all articles grouped by intent,
 * cluster FAQ. Hubs are 1 click from home and link to every article (and back).
 */
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import FAQ from '@/components/FAQ.astro';
import AdSlot from '@/components/AdSlot.astro';
import GuideCard from '@/components/GuideCard.astro';
import type { Article, Cluster } from '@/lib/content';
import { articleUrl, clusterUrl } from '@/lib/links';
import {
  breadcrumbSchema,
  buildSeo,
  collectionPageSchema,
  countWords,
  faqSchema,
  readingTimeMinutes,
} from '@/lib/seo';

interface Props {
  cluster: Cluster;
  articles: Article[];
}

const { cluster, articles } = Astro.props;
const path = clusterUrl(cluster.id);
const pillar = articles.find((a) => a.id === cluster.data.pillar || a.data.pillar);
const rest = articles.filter((a) => a.id !== pillar?.id);

const INTENT_LABELS: Record<Article['data']['intent'], string> = {
  'what-is': 'Explainers',
  'how-to': 'How-to guides',
  troubleshooting: 'Troubleshooting',
  comparison: 'Comparisons',
  legal: 'Legal and licensing',
};
const groups = (Object.keys(INTENT_LABELS) as Article['data']['intent'][])
  .map((intent) => ({
    intent,
    label: INTENT_LABELS[intent],
    items: rest.filter((a) => a.data.intent === intent),
  }))
  .filter((g) => g.items.length > 0);

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: cluster.data.navLabel, path },
];

const latest = articles[0]
  ? (articles[0].data.updatedAt ?? articles[0].data.publishedAt)
  : cluster.data.updatedAt;

const meta = buildSeo({
  title: cluster.data.title,
  description: cluster.data.description,
  path,
  updatedAt: latest,
});

const schema = [
  collectionPageSchema({
    path,
    name: cluster.data.h1,
    description: cluster.data.description,
    items: articles.map((a) => ({ name: a.data.title, path: articleUrl(a.id) })),
  }),
  breadcrumbSchema(breadcrumbs),
  cluster.data.reviewStatus === 'approved' ? faqSchema(cluster.data.faq) : undefined,
].filter((s): s is Record<string, unknown> => Boolean(s));

function minutes(article: Article): number {
  return readingTimeMinutes(countWords(article.body ?? ''));
}
---

<BaseLayout meta={meta} schema={schema}>
  <div data-pagefind-body data-area="hub">
    <header class="band">
      <div class="container page-pad">
        <Breadcrumbs items={breadcrumbs} />
        <h1 class="page-title">{cluster.data.h1}</h1>
        <p class="lede">{cluster.data.intro}</p>
      </div>
    </header>

    <div class="container page-pad">
      {pillar && (
        <section aria-labelledby="pillar-title">
          <h2 id="pillar-title" class="section-title">
            Start here
          </h2>
          <ul class="guide-grid">
            <li>
              <GuideCard
                href={articleUrl(pillar.id)}
                title={pillar.data.title}
                description={pillar.data.description}
                badge={cluster.data.navLabel}
                minutes={minutes(pillar)}
                image={pillar.data.cover}
              />
            </li>
          </ul>
        </section>
      )}

      {groups.map((g, i) => (
        <section aria-labelledby={`group-${g.intent}`} class="mt-10">
          <h2 id={`group-${g.intent}`} class="section-title">
            {g.label}
          </h2>
          <ul class="guide-grid">
            {g.items.map((article) => (
              <li>
                <GuideCard
                  href={articleUrl(article.id)}
                  title={article.data.title}
                  description={article.data.description}
                  badge={cluster.data.navLabel}
                  minutes={minutes(article)}
                  image={article.data.cover}
                />
              </li>
            ))}
          </ul>
          {i === 0 && articles.length >= 6 && (
            <AdSlot id={`hub-${cluster.id}-1`} format="leaderboard" />
          )}
        </section>
      ))}

      {articles.length === 0 && (
        <p class="lede">Guides for this topic are being prepared. Check back soon.</p>
      )}

      <div class="prose reading">
        <FAQ items={cluster.data.faq} title={`${cluster.data.navLabel}: common questions`} />
      </div>
    </div>
  </div>
</BaseLayout>
