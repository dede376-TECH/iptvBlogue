---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { getPublishedArticles } from '@/lib/content';
import { articleUrl, authorUrl } from '@/lib/links';
import { mdxComponents } from '@/components/mdx';
import { breadcrumbSchema, buildSeo, formatDate, personSchema, truncate } from '@/lib/seo';

export async function getStaticPaths() {
  const authors = await getCollection('authors');
  return authors.map((author) => ({ params: { slug: author.id }, props: { author } }));
}

const { author } = Astro.props;
const path = authorUrl(author.id);
const { Content } = await render(author);
const articles = (await getPublishedArticles()).filter((a) => a.data.author.id === author.id);
const { name, role, shortBio, avatar, links, credentials } = author.data;

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: `${name}`, path },
];
const meta = buildSeo({
  title: truncate(`${name}: ${role}`, 60),
  description: shortBio,
  path,
  image: avatar?.src,
  imageAlt: name,
});
const schema = [
  personSchema({
    slug: author.id,
    name,
    role,
    description: shortBio,
    image: avatar?.src,
    sameAs: Object.values(links).filter((v): v is string => Boolean(v)),
  }),
  breadcrumbSchema(breadcrumbs),
];
---

<BaseLayout meta={meta} schema={schema}>
  <div class="container page-pad" data-area="author">
    <div class="reading">
      <Breadcrumbs items={breadcrumbs} />
      <header class="flex items-start gap-5">
        {avatar && (
          <Image
            src={avatar}
            alt=""
            width={96}
            height={96}
            class="h-24 w-24 rounded-full"
            loading="eager"
          />
        )}
        <div>
          <h1 class="article-title">{name}</h1>
          <p class="lede">{role}</p>
          {credentials.length > 0 && (
            <ul class="mt-2 flex flex-wrap gap-2 text-xs">
              {credentials.map((c) => (
                <li class="chip">{c}</li>
              ))}
            </ul>
          )}
        </div>
      </header>

      <div class="prose mt-6 max-w-none">
        <Content components={mdxComponents} />
      </div>

      {articles.length > 0 && (
        <section aria-labelledby="author-articles" class="related">
          <h2 id="author-articles" class="section-title">
            Articles by {name}
          </h2>
          <ul class="guide-grid">
            {articles.map((article) => (
              <li>
                <article class="guide-card">
                  <h3 class="guide-card-title">
                    <a href={articleUrl(article.id)}>{article.data.title}</a>
                  </h3>
                  <p class="guide-card-meta">
                    {formatDate(article.data.updatedAt ?? article.data.publishedAt)}
                  </p>
                </article>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</BaseLayout>
