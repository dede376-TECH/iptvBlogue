---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildSeo } from '@/lib/seo';

const meta = buildSeo({
  title: 'Search IPTV Guides',
  description:
    'Search every IPTV guide on this site: technical explainers, setup, troubleshooting, players and legal streaming.',
  path: '/search/',
  noindex: true,
});
---

<BaseLayout meta={meta}>
  <div class="container page-pad">
    <div class="reading">
      <h1 class="article-title">Search</h1>
      <form role="search" action="/search/" method="get" class="mt-6" onsubmit="return false">
        <label for="search-input" class="sr-only">
          Search guides
        </label>
        <input
          id="search-input"
          name="q"
          type="search"
          placeholder="e.g. EPG not showing"
          autocomplete="off"
          class="search-field"
        />
      </form>
      <p id="search-status" class="meta mt-3" aria-live="polite"></p>
      <ul id="search-results" class="guide-grid"></ul>
    </div>
  </div>
  <script src="../scripts/search.ts"></script>
</BaseLayout>
