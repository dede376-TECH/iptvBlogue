---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildSeo } from '@/lib/seo';

const meta = buildSeo({
  title: 'Search IPTV Guides',
  description:
    'Search every IPTV guide on this site: technical explainers, setup, troubleshooting, players and legal streaming.',
  path: '/search/',
  noindex: true,
});
---

<BaseLayout meta={meta}>
  <div class="container-prose py-8">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">Search</h1>
    <form role="search" action="/search/" method="get" class="mt-6" onsubmit="return false">
      <label for="search-input" class="sr-only">
        Search guides
      </label>
      <input
        id="search-input"
        name="q"
        type="search"
        placeholder="e.g. EPG not showing"
        autocomplete="off"
        class="w-full rounded-md border border-slate-300 px-4 py-3 text-lg focus:border-brand-700"
      />
    </form>
    <p id="search-status" class="mt-3 text-sm text-slate-500" aria-live="polite"></p>
    <ul id="search-results" class="mt-4 space-y-3"></ul>
  </div>
  <script src="@/scripts/search.ts"></script>
</BaseLayout>
