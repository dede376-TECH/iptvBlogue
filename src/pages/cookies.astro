---
/**
 * Cookie policy + preferences. Optional categories render only for tools that are actually
 * switched on. With analytics and advertising both off, there is no banner and no script.
 */
import { getEntry } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import { CONSENT } from '@/lib/site';

const page = await getEntry('pages', 'cookies');
if (!page) throw new Error('Missing src/content/pages/cookies.mdx');
const optional = CONSENT.analytics || CONSENT.ads;
---

<PageLayout page={page}>
  <section id="preferences" aria-labelledby="preferences-title" class="not-prose card mt-8">
    <h2 id="preferences-title" class="text-xl font-semibold text-slate-900">
      Your preferences
    </h2>
    {optional ? (
      <>
        <p class="mt-1 text-sm text-slate-600" data-consent-status>
          No choice saved yet.
        </p>
        <form class="mt-4 space-y-3" onsubmit="return false">
          <label class="flex items-start gap-3">
            <input type="checkbox" checked disabled class="mt-1" />
            <span>
              <span class="font-medium text-slate-900">Strictly necessary</span>
              <span class="block text-sm text-slate-600">
                Always on. Stores your cookie choice in this browser.
              </span>
            </span>
          </label>
          {CONSENT.analytics && (
            <label class="flex items-start gap-3">
              <input type="checkbox" data-consent-pref="analytics" class="mt-1" />
              <span>
                <span class="font-medium text-slate-900">Analytics</span>
                <span class="block text-sm text-slate-600">
                  Google Analytics 4 usage statistics.
                </span>
              </span>
            </label>
          )}
          {CONSENT.ads && (
            <label class="flex items-start gap-3">
              <input type="checkbox" data-consent-pref="ads" class="mt-1" />
              <span>
                <span class="font-medium text-slate-900">Advertising</span>
                <span class="block text-sm text-slate-600">
                  Personalised ads and measurement. Unticking this is also the "Do Not Sell or Share
                  My Personal Information" choice.
                </span>
              </span>
            </label>
          )}
          <div class="flex flex-wrap gap-2 pt-2">
            <button type="button" class="btn-primary" data-consent="save">
              Save preferences
            </button>
            <button type="button" class="btn-secondary" data-consent="accept">
              Accept all
            </button>
            <button type="button" class="btn-secondary" data-consent="reject">
              Reject non-essential
            </button>
          </div>
        </form>
      </>
    ) : (
      <p class="mt-2 text-sm text-slate-600">
        Analytics and advertising are switched off. This site does not set optional cookies, and
        there is no choice to save. The "Do Not Sell or Share My Personal Information" request is
        already met, because no advertising cookies are used.
      </p>
    )}
  </section>
</PageLayout>
