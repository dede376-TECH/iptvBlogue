---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getVisibleClusters } from '@/lib/content';
import { clusterUrl } from '@/lib/links';
import { buildSeo } from '@/lib/seo';

const clusters = await getVisibleClusters();
const meta = buildSeo({
  title: 'Page Not Found',
  description:
    'The page you were looking for does not exist. Browse IPTV guides by topic or use the search.',
  path: '/404/',
  noindex: true,
});
---

<BaseLayout meta={meta}>
  <div class="container page-pad">
    <div class="reading">
      <h1 class="article-title">Page not found</h1>
      <p class="lede">
        That page does not exist or has moved. Try the <a href="/search/">search</a> or browse a
        topic:
      </p>
      <ul class="guide-grid">
        {clusters.map((c) => (
          <li>
            <a href={clusterUrl(c.id)} class="guide-card-title">
              {c.data.h1}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>
