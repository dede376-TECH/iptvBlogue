---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ClusterIcon from '@/components/ClusterIcon.astro';
import GuideCard from '@/components/GuideCard.astro';
import { mdxComponents } from '@/components/mdx';
import { getVisibleClusters, getPublishedArticles } from '@/lib/content';
import { articleUrl, clusterUrl } from '@/lib/links';
import { buildSeo, countWords, readingTimeMinutes, webPageSchema } from '@/lib/seo';
import { SITE } from '@/lib/site';

const clusters = await getVisibleClusters();
const articles = await getPublishedArticles();
const latest = articles.slice(0, 6);
const home = await getEntry('pages', 'home');
if (!home) throw new Error('Missing src/content/pages/home.mdx');
const { Content: HomeIntro } = await render(home);

const meta = buildSeo({
  title: home.data.title,
  description: home.data.description,
  path: '/',
  updatedAt: home.data.updatedAt,
});
const schema = [webPageSchema({ path: '/', name: SITE.name, description: meta.description })];
---

<BaseLayout meta={meta} schema={schema}>
  <section class="band">
    <div class="container page-pad">
      <h1 class="page-title">{home.data.h1}</h1>
      <p class="lede">{SITE.tagline}</p>
      <form class="search-box" role="search" action="/search/" method="get">
        <label class="sr-only" for="home-search">
          Search guides
        </label>
        <input id="home-search" name="q" type="search" placeholder="Search guides" />
        <button type="submit">Search</button>
      </form>
      <div class="prose reading mt-6">
        <HomeIntro components={mdxComponents} />
      </div>
    </div>
  </section>

  <section aria-labelledby="topics-title" class="container page-pad" data-area="home-topics">
    <h2 id="topics-title" class="section-title">
      Browse by topic
    </h2>
    <ul class="cluster-grid">
      {clusters.map((c) => (
        <li>
          <a href={clusterUrl(c.id)} class="cluster-card">
            <ClusterIcon id={c.id} />
            <h3>{c.data.navLabel}</h3>
            <p>{c.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {latest.length > 0 && (
    <section aria-labelledby="latest-title" class="container page-pad" data-area="home-latest">
      <h2 id="latest-title" class="section-title">
        Latest guides
      </h2>
      <ul class="guide-grid">
        {latest.map((article) => (
          <li>
            <GuideCard
              href={articleUrl(article.id)}
              title={article.data.title}
              description={article.data.description}
              badge={clusters.find((c) => c.id === article.data.cluster)?.data.navLabel}
              minutes={readingTimeMinutes(countWords(article.body ?? ''))}
            />
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
