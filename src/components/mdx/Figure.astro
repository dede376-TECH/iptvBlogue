---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

export type FigureKind = 'screenshot' | 'illustration' | 'diagram';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  kind: FigureKind;
  /** Only for the LCP image at the top of a page. Everything else loads lazily. */
  eager?: boolean;
  sizes?: string;
}

const {
  src,
  alt,
  caption,
  kind,
  eager = false,
  sizes = '(max-width: 768px) 100vw, 700px',
} = Astro.props;

const widths = [480, 720, 1080].filter((w) => w < src.width).concat(Math.min(src.width, 1400));
const cleanAlt = alt?.trim() ?? '';
if (!cleanAlt) throw new Error(`<Figure> needs a non-empty alt (caption: "${caption}")`);
if (/^(image|photo|picture) of\b/i.test(cleanAlt))
  throw new Error(
    `<Figure> alt must describe the content, not start with "${cleanAlt.split(' ').slice(0, 2).join(' ')}"`,
  );
---

<figure class="figure not-prose" data-figure-kind={kind}>
  {kind === 'illustration' && <span class="figure-label">Illustration</span>}
  <Picture
    src={src}
    alt={cleanAlt}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    widths={widths}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
  />
  <figcaption>{caption}</figcaption>
</figure>
