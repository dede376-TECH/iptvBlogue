---
import type { BreadcrumbItem } from '@/lib/seo';

interface Props {
  items: BreadcrumbItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<nav aria-label="Breadcrumb" class:list={['text-sm text-slate-500', className]}>
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {items.map((item, i) => {
      const last = i === items.length - 1;
      return (
        <li class="flex items-center gap-x-2">
          {last ? (
            <span aria-current="page" class="text-slate-700">
              {item.name}
            </span>
          ) : (
            <a href={item.path} class="hover:text-brand-700 hover:underline">
              {item.name}
            </a>
          )}
          {!last && <span aria-hidden="true">/</span>}
        </li>
      );
    })}
  </ol>
</nav>
