---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  href: string;
  title: string;
  description: string;
  minutes?: number;
  badge?: string;
  image?: { src: ImageMetadata; alt: string; kind: 'screenshot' | 'illustration' | 'diagram' };
}

const { href, title, description, minutes, badge, image } = Astro.props;
---

<article class="guide-card">
  {image && (
    <figure class="guide-card-media" data-figure-kind={image.kind}>
      {image.kind === 'illustration' && <span class="figure-label">Illustration</span>}
      <Picture
        src={image.src}
        alt={image.alt}
        formats={['avif', 'webp']}
        fallbackFormat="webp"
        widths={[320, 480]
          .filter((w) => w < image.src.width)
          .concat(Math.min(image.src.width, 640))}
        sizes="(max-width: 640px) 100vw, 360px"
        loading="lazy"
        decoding="async"
      />
    </figure>
  )}
  {badge && <p class="badge">{badge}</p>}
  <h3 class="guide-card-title">
    <a href={href}>{title}</a>
  </h3>
  <p class="guide-card-desc">{description}</p>
  {minutes != null && <p class="guide-card-meta">{minutes} min read</p>}
</article>
