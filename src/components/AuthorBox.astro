---
import { Image } from 'astro:assets';
import type { Author } from '@/lib/content';
import { authorUrl } from '@/lib/links';

interface Props {
  author: Author;
  /** Compact = byline under the title; full = box at the end of the article. */
  variant?: 'compact' | 'full';
}

const { author, variant = 'full' } = Astro.props;
const href = authorUrl(author.id);
const { name, role, shortBio, avatar, credentials, links } = author.data;
const linkEntries = Object.entries(links).filter(([, v]) => Boolean(v)) as [string, string][];
---

{variant === 'compact' ? (
  <a href={href} rel="author" class="author-byline">
    {avatar && <Image src={avatar} alt="" width={32} height={32} class="h-8 w-8" loading="eager" />}
    <span>{name}</span>
  </a>
) : (
  <aside aria-label="About the author" class="author-box not-prose">
    {avatar && (
      <Image src={avatar} alt="" width={64} height={64} class="h-16 w-16 shrink-0" loading="lazy" />
    )}
    <div>
      <p class="author-kicker">Written by</p>
      <p class="author-name">
        <a href={href} rel="author">
          {name}
        </a>
      </p>
      <p class="meta">{role}</p>
      <p class="mt-2 text-sm">{shortBio}</p>
      {credentials.length > 0 && (
        <ul class="mt-2 flex flex-wrap gap-2 text-xs">
          {credentials.map((c) => (
            <li class="chip">{c}</li>
          ))}
        </ul>
      )}
      {linkEntries.length > 0 && (
        <ul class="mt-2 flex flex-wrap gap-3 text-sm">
          {linkEntries.map(([key, url]) => (
            <li>
              <a href={url} rel="me noopener" target="_blank">
                {key}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </aside>
)}
