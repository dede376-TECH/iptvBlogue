---
import type { Article } from '@/lib/content';
import GuideCard from '@/components/GuideCard.astro';
import { articleUrl } from '@/lib/links';
import { countWords, readingTimeMinutes } from '@/lib/seo';

interface Props {
  articles: Article[];
  title?: string;
}

const { articles, title = 'Related guides' } = Astro.props;
---

{articles.length > 0 && (
  <section aria-labelledby="related-title" class="related not-prose">
    <h2 id="related-title" class="section-title">
      {title}
    </h2>
    <ul class="guide-grid">
      {articles.map((article) => (
        <li>
          <GuideCard
            href={articleUrl(article.id)}
            title={article.data.title}
            description={article.data.description}
            minutes={readingTimeMinutes(countWords(article.body ?? ''))}
          />
        </li>
      ))}
    </ul>
  </section>
)}
