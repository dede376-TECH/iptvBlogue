---
interface Props {
  items: string[];
  title?: string;
}

const { items, title = 'Key takeaways' } = Astro.props;
---

{items.length > 0 && (
  <aside aria-labelledby="key-takeaways-title" class="takeaways not-prose">
    <p id="key-takeaways-title" class="takeaways-title">
      {title}
    </p>
    <ul>
      {items.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </aside>
)}
