---
/**
 * All <head> SEO tags for a page. Pass the already-computed meta from `buildSeo()`.
 */
import type { SeoMeta } from '@/lib/seo';
import { SITE } from '@/lib/site';

interface Props {
  meta: SeoMeta;
}

const { meta } = Astro.props;
---

<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<link rel="canonical" href={meta.canonical} />
<meta name="robots" content={meta.robots} />
{meta.hreflang.map((h) => (
  <link rel="alternate" hreflang={h.lang} href={h.href} />
))}

<meta property="og:type" content={meta.type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={meta.ogLocale} />
<meta property="og:title" content={meta.title} />
<meta property="og:description" content={meta.description} />
<meta property="og:url" content={meta.canonical} />
<meta property="og:image" content={meta.image} />
<meta property="og:image:alt" content={meta.imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{meta.type === 'article' && (
  <>
    {meta.publishedAt && <meta property="article:published_time" content={meta.publishedAt} />}
    {meta.updatedAt && <meta property="article:modified_time" content={meta.updatedAt} />}
    {meta.authorName && <meta property="article:author" content={meta.authorName} />}
  </>
)}

<meta name="twitter:card" content="summary_large_image" />
{SITE.twitterHandle && <meta name="twitter:site" content={SITE.twitterHandle} />}
<meta name="twitter:title" content={meta.title} />
<meta name="twitter:description" content={meta.description} />
<meta name="twitter:image" content={meta.image} />
<meta name="twitter:image:alt" content={meta.imageAlt} />
