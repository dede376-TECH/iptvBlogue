---
/**
 * Visible FAQ block. The matching FAQPage JSON-LD is emitted by the layout via `faqSchema()`
 * so that the structured data always mirrors visible content.
 */
import type { FaqItem } from '@/lib/seo';

interface Props {
  items: FaqItem[];
  title?: string;
  headingLevel?: 2 | 3;
}

const { items, title = 'Frequently asked questions', headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const Sub = `h${headingLevel + 1}` as 'h3' | 'h4';
---

{items.length > 0 && (
  <section id="faq" aria-labelledby="faq-title" class="faq">
    <Heading id="faq-title" class="section-title">
      {title}
    </Heading>
    <dl class="faq-list not-prose">
      {items.map((f) => (
        <div class="faq-item">
          <dt>
            <Sub>{f.question}</Sub>
          </dt>
          <dd>{f.answer}</dd>
        </div>
      ))}
    </dl>
  </section>
)}
